ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_StrongP@ss1
ADMIN_FULL_NAME=System Administrator

# Demo Data Seeding
# Set SEED_DEMO=true to seed initial doctor, manager, patient and appointments
